# Use a separate tunnel ID and connection for editing.
# Copy to /etc/videogame-collection/tunnel-write.env; chmod 600.
CONTROL_PLANE_TUNNEL_ID=tunnel_REPLACE_WITH_WRITE_TUNNEL_ID
CONTROL_PLANE_API_KEY=REPLACE_WITH_RUNTIME_KEY
MCP_COMMAND="/bin/sh /opt/VideogameCollection/deploy/private-tunnel/run-mcp.sh write"
HEALTH_LISTEN_ADDR=127.0.0.1:8782

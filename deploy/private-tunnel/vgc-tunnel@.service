[Unit]
Description=VideogameCollection private MCP tunnel (%i)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=vgc-tunnel
Group=vgc-tunnel
SupplementaryGroups=docker
WorkingDirectory=/opt/VideogameCollection
EnvironmentFile=/etc/videogame-collection/tunnel-%i.env
ExecStart=/usr/local/bin/tunnel-client run
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

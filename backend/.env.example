# Existing integrations
# Login signing key is generated beside the database when omitted.
# Existing sessions must sign in again when upgrading from the old hardcoded key.
AUTH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_DAYS=7

OPENAI_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional server-wide key for Steam owned-library sync. A per-user key can
# instead be entered in Videogames > User Settings.
STEAM_WEB_API_KEY=

# Optional encryption passphrase for API keys entered in User Settings.
# If omitted, Linux creates .steam-secrets.key beside the SQLite database;
# keep that file in the same persistent volume as the database.
STEAM_SECRET_ENCRYPTION_KEY=
# STEAM_SECRET_KEY_FILE=/app/data/.steam-secrets.key

# BoardGameGeek XML API2 application token
# Register an application at https://boardgamegeek.com/applications
BGG_API_TOKEN=

# Compressed SQLite backups. Defaults: next to the database, daily, latest 7.
BACKUP_DIR=
BACKUP_RETENTION=7
BACKUP_INTERVAL_HOURS=24

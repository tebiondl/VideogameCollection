# Existing integrations
OPENAI_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional server-wide key for Steam owned-library sync. A per-user key can
# instead be entered in Videogames > Games I want > Admin.
STEAM_WEB_API_KEY=

# BoardGameGeek XML API2 application token
# Register an application at https://boardgamegeek.com/applications
BGG_API_TOKEN=

# Compressed SQLite backups. Defaults: next to the database, daily, latest 7.
BACKUP_DIR=
BACKUP_RETENTION=7
BACKUP_INTERVAL_HOURS=24
